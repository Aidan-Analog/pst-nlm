{%- comment -%}
  Renders a single product card.
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}

<article class="product-card">
  <a href="{{ product.url }}" class="product-image">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="600"
        height="{{ 600 | divided_by: product.featured_image.aspect_ratio | default: 600 }}"
      >
    {%- else -%}
      <span>{{ product.title }}</span>
    {%- endif -%}
  </a>
  <div class="product-body">
    {%- if product.available == false -%}
      <span class="badge badge-grey" style="width: fit-content;">sold out</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="badge badge-pink" style="width: fit-content;">sale</span>
    {%- endif -%}

    <h3 class="product-card-title"><a href="{{ product.url }}">{{ product.title | downcase }}</a></h3>

    <p class="product-price">
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>{{ product.price | money }}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </p>

    {%- if product.available and product.variants.size == 1 -%}
      {%- assign variant = product.variants.first -%}
      <form method="post" action="{{ routes.cart_add_url }}">
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button type="submit" class="btn btn-primary btn-block">add to cart</button>
      </form>
    {%- elsif product.available -%}
      <a href="{{ product.url }}" class="btn btn-primary btn-block">choose options</a>
    {%- else -%}
      <button type="button" class="btn btn-primary btn-block" disabled>sold out</button>
    {%- endif -%}
  </div>
</article>
