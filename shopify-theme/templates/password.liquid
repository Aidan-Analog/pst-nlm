{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="icon" type="image/png" href="{{ 'icon-badge.png' | asset_url }}">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <section class="hero stave-pattern" style="min-height:100vh;">
    <div class="container hero-inner reveal is-visible" style="text-align:left;">
      <img class="hero-icon" src="{{ 'icon-badge.png' | asset_url }}" alt="" width="56" height="56">
      <p class="eyebrow" style="color:rgba(255,255,255,0.65)">coming soon</p>
      <h1 class="bb-h1">something's cooking.</h1>
      <p class="script-tag hero-tagline">nice to smell ya.</p>
      <p class="hero-sub">{{ shop.name }} is putting the finishing touches on the shop. Pop your email in below and we'll let you know the second the doors open.</p>

      {%- form 'customer', class: 'contact-form', id: 'PasswordSignupForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-success">Thanks — we'll be in touch.</p>
        {%- else -%}
          <input type="hidden" name="customer[tags]" value="prospect,password_page">
          <div class="field">
            <label for="PasswordEmail">Email</label>
            <input type="email" id="PasswordEmail" name="customer[email]" required>
          </div>
          <button type="submit" class="btn btn-primary btn-block">notify me</button>
        {%- endif -%}
      {%- endform -%}

      {%- if shop.password_message != blank -%}
        <div style="margin-top:var(--space-6);color:rgba(255,255,255,0.7);">{{ shop.password_message }}</div>
      {%- endif -%}

      {%- form 'storefront_password', class: 'contact-form', style: 'margin-top:var(--space-5);' -%}
        <div class="field">
          <label for="StorePassword">Have the password?</label>
          <input type="password" id="StorePassword" name="password" placeholder="Enter store password">
        </div>
        <button type="submit" class="btn btn-outline-pink on-dark btn-block">enter</button>
      {%- endform -%}
    </div>
  </section>
</body>
</html>
