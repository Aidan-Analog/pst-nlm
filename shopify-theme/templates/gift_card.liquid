{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="gift-card">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ gift_card.initial_value | money }} gift card for {{ shop.name }}</title>
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/png" href="{{ 'icon-badge.png' | asset_url }}">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <style>
    body { padding: var(--space-7) var(--space-5); }
    .gift-card-wrap { max-width: 560px; margin: 0 auto; text-align: center; }
    .gift-card-panel { background: linear-gradient(145deg, var(--clr-pink-800), var(--clr-blue-900)); color: #fff; border-radius: var(--radius-lg); padding: var(--space-7); box-shadow: var(--shadow-raised-4); }
    .gift-card-code { font-family: var(--font-mono, monospace); font-size: var(--text-xl); letter-spacing: 0.1em; background: rgba(255,255,255,0.12); border-radius: var(--radius-sm); padding: var(--space-4); margin: var(--space-5) 0; }
    @media print { .no-print { display: none; } }
  </style>
</head>
<body>
  <div class="gift-card-wrap">
    <img class="logo-img" src="{{ 'logo-pink-horiz.svg' | asset_url }}" alt="{{ shop.name }}" style="margin: 0 auto var(--space-6);" width="150" height="38">

    <div class="gift-card-panel">
      <p class="eyebrow" style="color:rgba(255,255,255,0.7);">gift card</p>
      <h1 class="bb-h1" style="font-size:var(--text-4xl);color:#fff;">{{ gift_card.balance | money }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="badge badge-pink" style="margin-top:var(--space-3);">expired</p>
      {%- endif -%}
      <p class="gift-card-code">{{ gift_card.code | format_code }}</p>
    </div>

    <p style="margin-top:var(--space-6);">Use this code at checkout on {{ shop.name }}.</p>
    <p class="no-print"><button type="button" class="btn btn-outline-pink" onclick="window.print()">print</button></p>
  </div>
</body>
</html>
