<section class="gigs" id="gigs">
  <div class="container reveal">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="bb-h2">{{ section.settings.heading }}</h2>

    {%- assign gig_blocks = section.blocks | where: 'type', 'gig' -%}

    {%- if section.settings.show_filters and gig_blocks.size > 0 -%}
      {%- assign filter_tags = '' -%}
      {%- for block in gig_blocks -%}
        {%- unless filter_tags contains block.settings.filter_tag -%}
          {%- assign filter_tags = filter_tags | append: block.settings.filter_tag | append: ',' -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- assign filter_tags = filter_tags | split: ',' -%}

      <div class="gig-filters" id="gigFilters">
        <span class="chip chip-active" data-filter="all">all shows</span>
        {%- for tag in filter_tags -%}
          {%- if tag != blank -%}
            <span class="chip" data-filter="{{ tag | handle }}">{{ tag }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if gig_blocks.size > 0 -%}
      <ul class="gig-list" id="gigList">
        {%- for block in gig_blocks -%}
          <li class="gig-card {{ block.settings.card_style }}" data-gig-card="{{ block.settings.filter_tag | handle }}" {{ block.shopify_attributes }}>
            <div class="gig-date">{{ block.settings.day }}<span class="gig-month">{{ block.settings.month }}</span></div>
            <div class="gig-info">
              <p class="gig-name">{{ block.settings.name }}</p>
              <p class="gig-venue">{{ block.settings.venue }}</p>
            </div>
            {%- if block.settings.badge_label != blank -%}
              <span class="badge badge-pink">{{ block.settings.badge_label }}</span>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a class="btn btn-outline-pink" href="{{ block.settings.link }}">details</a>
            {%- else -%}
              <span></span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="gig-empty">No shows on sale right now — check back soon.</p>
    {%- endif -%}

    {%- if section.settings.show_placeholder_note -%}
      <p class="placeholder-note">Placeholder dates &amp; venues — edit these gig blocks in the theme editor with real tour dates.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gigs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "gigs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "catch us live." },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter chips", "default": true },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder note", "default": true }
  ],
  "blocks": [
    {
      "type": "gig",
      "name": "Gig",
      "settings": [
        { "type": "text", "id": "day", "label": "Day", "default": "14" },
        { "type": "text", "id": "month", "label": "Month", "default": "jun" },
        { "type": "text", "id": "name", "label": "Event name", "default": "Summer Sessions" },
        { "type": "text", "id": "venue", "label": "Venue", "default": "Iveagh Gardens, Dublin" },
        { "type": "text", "id": "filter_tag", "label": "Filter tag (e.g. city)", "default": "dublin" },
        { "type": "text", "id": "badge_label", "label": "Badge label", "default": "tickets available" },
        {
          "type": "select",
          "id": "card_style",
          "label": "Card style",
          "options": [
            { "value": "", "label": "Light" },
            { "value": "is-dark", "label": "Dark" },
            { "value": "is-brand", "label": "Brand (purple)" }
          ],
          "default": ""
        },
        { "type": "url", "id": "link", "label": "Details link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gigs",
      "blocks": [
        {
          "type": "gig",
          "settings": { "day": "14", "month": "jun", "name": "Summer Sessions", "venue": "Iveagh Gardens, Dublin", "filter_tag": "dublin", "badge_label": "tickets available", "card_style": "" }
        },
        {
          "type": "gig",
          "settings": { "day": "22", "month": "jul", "name": "Wilderness-on-the-Lee", "venue": "Fitzgerald Park, Cork", "filter_tag": "cork", "badge_label": "sold out", "card_style": "is-dark" }
        },
        {
          "type": "gig",
          "settings": { "day": "08", "month": "aug", "name": "Boomtown by the Bay", "venue": "Salthill Prom, Galway", "filter_tag": "galway", "badge_label": "free entry", "card_style": "is-brand" }
        },
        {
          "type": "gig",
          "settings": { "day": "03", "month": "oct", "name": "Private Wedding", "venue": "Wicklow, Ireland", "filter_tag": "private hire", "badge_label": "private event", "card_style": "" }
        }
      ]
    }
  ]
}
{% endschema %}
