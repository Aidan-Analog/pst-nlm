<div class="container page-section">
  <div class="page-header" style="padding-top:0;">
    <p class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</p>
    <h1 class="bb-h2">{{ article.title | downcase }}</h1>
  </div>

  <div class="article-body">
    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | escape }}" width="1200" height="{{ 1200 | divided_by: article.image.aspect_ratio | default: 675 }}">
    {%- endif -%}
    {{ article.content }}
  </div>

  <p style="text-align:center;margin-top:var(--space-7);">
    <a href="{{ blog.url }}" class="btn btn-outline-pink">&larr; back to {{ blog.title | downcase }}</a>
  </p>
</div>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
